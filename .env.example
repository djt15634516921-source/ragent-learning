# IDEA/系统环境变量填写参考，Spring Boot 不会自动读取此文件。
DB_PASSWORD=replace_with_existing_postgres_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=copy_from_your_private_reference_config
REDIS_DATABASE=0
AUTH_REDIS_PREFIX=ragent-learning:auth:
AUTH_TOKEN_TIMEOUT=28800
SERVER_PORT=18081
CHAT_STREAM_TIMEOUT_MS=90000
KNOWLEDGE_STORAGE_ROOT=data/knowledge
LLM_CHAT_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=your_existing_model
LLM_API_KEY=replace_locally
