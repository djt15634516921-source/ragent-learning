# IDEA/系统环境变量填写参考，Spring Boot 不会自动读取此文件。
DB_PASSWORD=replace_with_existing_postgres_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=copy_from_your_private_reference_config
REDIS_DATABASE=0
AUTH_REDIS_PREFIX=ragent-learning:auth:
AUTH_TOKEN_TIMEOUT=28800
SERVER_PORT=18081
CHAT_STREAM_TIMEOUT_MS=90000
KNOWLEDGE_STORAGE_ROOT=data/knowledge
LLM_CHAT_URL=https://your-provider.example/v1/chat/completions
LLM_MODEL=your_existing_model
LLM_API_KEY=replace_locally

# 以下可选；百炼现有地址可自动派生 /embeddings，默认复用 LLM_API_KEY。
EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_URL=https://your-provider.example/v1/embeddings
# EMBEDDING_API_KEY=replace_locally_if_using_a_separate_key
RAG_TOP_K=4
RAG_RECALL_BUDGET=16
RAG_RERANK_CANDIDATE_LIMIT=12
RAG_MIN_SCORE=0.35
RAG_MAX_INDEX_CHUNKS=500
# 只在知识库连续提问时调用一次现有聊天模型；超时/无效输出返回原句检索。
RAG_REWRITE_ENABLED=true
RAG_REWRITE_TIMEOUT_MS=3000
RAG_MAX_CONTEXT_CHARS=6000
# 重排默认关闭；配置后启用。它是独立的排序模型，不替换现有聊天/Embedding模型。
RAG_RERANK_ENABLED=false
RERANK_MODEL=qwen3-rerank
# 按百炼控制台的业务空间和地域填写原生text-rerank完整地址，不能填chat或/compatible-api/v1/reranks。
# RERANK_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_API_KEY=replace_locally_if_using_a_separate_key
RERANK_TIMEOUT_MS=3000
# 粗略字符预算：每个候选都计入问题长度；不是平台Token计量或费用上限。
RAG_RERANK_MAX_INPUT_CHARS=24000
# Agent 使用 LLM_CHAT_URL、LLM_MODEL 和 LLM_API_KEY 调用支持工具的聊天模型。
AGENT_MAX_ITERS=3
AGENT_TIMEOUT_MS=30000
# 默认切分参数；独立接口和一键入库均可按次覆盖。
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
# 单实例后台入库；租约至少为轮询间隔的3倍。重启后中断任务等待手动重试。
KNOWLEDGE_INGESTION_WORKERS=2
KNOWLEDGE_INGESTION_POLL_MS=1000
KNOWLEDGE_INGESTION_LEASE_MS=15000
KNOWLEDGE_CLEANUP_POLL_MS=30000
